# Copy to .env and fill in. NEVER commit .env.
KYBERNAUT_JWT_SECRET=change-me-another-long-random-string
KYBERNAUT_JWT_ISSUER=kybernaut
KYBERNAUT_JWT_AUDIENCE=kybernaut-api

# Required by the local Compose Grafana service. Set a strong local secret.
GRAFANA_ADMIN_PASSWORD=

# Required by the payment-service PostgreSQL container and client.
PAYMENT_DB_PASSWORD=
# Optional loopback-only host port for the payment history migration utility.
# PAYMENT_DB_HOST_PORT=5433

# Optional: LLM RCA (without it RCA reports "unavailable"; nothing is fabricated)
# GROQ_API_KEY=
# KYBERNAUT_LLM_MODEL=openai/gpt-oss-120b
# KYBERNAUT_RCA_TIMEOUT_SECONDS=20

# Remediation safety (defaults shown)
KYBERNAUT_REMEDIATION_MODE=dry_run           # dry_run | live (live only on kind-* context)
KYBERNAUT_ALLOWED_CONTEXT_PREFIX=kind-
KYBERNAUT_POLICY_AUTO_REMEDIATION=false      # keep false unless you accept auto restarts
KYBERNAUT_POLICY_MIN_CONFIDENCE=0.6
KYBERNAUT_POLICY_AUTO_CONFIDENCE=0.9
KYBERNAUT_POLICY_MAX_ACTIONS=3
KYBERNAUT_POLICY_WINDOW_SECONDS=3600
KYBERNAUT_MAX_REMEDIATION_ATTEMPTS=2
KYBERNAUT_VERIFY_ATTEMPTS=5
KYBERNAUT_VERIFY_INTERVAL=3

# Prometheus feature freshness (optional; defaults shown)
KYBERNAUT_PROMETHEUS_MAX_SAMPLE_AGE_SECONDS=30
KYBERNAUT_PROMETHEUS_MAX_SAMPLE_SKEW_SECONDS=10

# Background application anomaly polling (optional; defaults shown)
KYBERNAUT_ANOMALY_MONITOR_ENABLED=true
KYBERNAUT_ANOMALY_POLL_INTERVAL_SECONDS=60

# Controlled incident generation is development-only and requires the
# kind-kybernaut cluster and kybernaut-lab namespace.
# KYBERNAUT_LAB_AUTOGEN=false
# KYBERNAUT_LAB_AUTOGEN_INTERVAL_SECONDS=180

# Storage (optional overrides)
# KYBERNAUT_DATABASE_PATH=/path/to/incidents.db
# KYBERNAUT_AUDIT_PATH=/path/to/remediation_audit.jsonl

# Weekly cost report. Recipient is configurable and defaults to this address.
KYBERNAUT_COST_REPORT_RECIPIENT=jananiviswa05@gmail.com
# Email is disabled by default; sending also requires the CLI --send-email flag.
KYBERNAUT_COST_REPORT_EMAIL_ENABLED=false
# Optional report directory override. The default is reports/weekly-cost.
# KYBERNAUT_WEEKLY_COST_REPORT_DIR=/path/to/weekly-cost-reports
# Illustrative local-demo defaults for live Prometheus usage estimates (USD).
# These are internal rates, not actual cloud-provider costs.
# Other environments must explicitly configure their own approved rates.
# KYBERNAUT_COST_CPU_PER_CORE_HOUR_USD=10.00
# KYBERNAUT_COST_MEMORY_PER_GIB_HOUR_USD=5.25
# Four-service failure injection is available only in the local-demo environment.
# Generate a random token (for example: openssl rand -hex 32) and use the same
# value for the API process and all four target-service containers.
# KYBERNAUT_ENVIRONMENT=local-demo
# KYBERNAUT_FAILURE_SIMULATION_TOKEN=
# Set KYBERNAUT_SERVICE_SIMULATION_ENABLED=false to disable local fault batches.
# Optional criteria; defaults are 24 samples, 80% period coverage, 30% CPU
# average, 40% memory average, 85% pressure, 10% pressure sample ratio,
# and an 80% peak guard for downsizing.
# KYBERNAUT_COST_MIN_SAMPLES=24
# KYBERNAUT_COST_MINIMUM_COVERAGE=0.8
# KYBERNAUT_COST_LOW_CPU_AVERAGE=0.3
# KYBERNAUT_COST_LOW_MEMORY_AVERAGE=0.4
# KYBERNAUT_COST_PRESSURE_THRESHOLD=0.85
# KYBERNAUT_COST_PRESSURE_SAMPLE_RATIO=0.1
# KYBERNAUT_COST_MAXIMUM_DOWNSIZE_PEAK=0.8
# SMTP values are only needed after explicitly enabling delivery. Never commit
# real credentials.
# KYBERNAUT_COST_SMTP_HOST=
# KYBERNAUT_COST_SMTP_PORT=587
# KYBERNAUT_COST_SMTP_FROM=
# KYBERNAUT_COST_SMTP_USERNAME=
# KYBERNAUT_COST_SMTP_PASSWORD=
